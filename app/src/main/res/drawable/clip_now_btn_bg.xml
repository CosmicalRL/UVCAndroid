<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval"><solid android:color="#2A2340" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#6E4DE0" />
            <stroke android:width="7dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#7F5AF0" />
            <stroke android:width="7dp" android:color="#A98DFF" />
        </shape>
    </item>
</selector>
